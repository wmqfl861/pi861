{
  "schemaVersion": 1,
  "id": "pi-alpha",
  "version": "0.1.0",
  "status": "configured-unarmed",
  "purpose": "建立能自动研究、动态组队和流程设计的平台；这是首版研发团队，不是所有业务的固定团队。",
  "baselineCommit": "1381dda4a8abf0f085766fb8b4a47dd623f806b1",
  "bootstrapOwner": {
    "kind": "current-assistant-session",
    "responsibilities": [
      "research",
      "planning",
      "self-critique",
      "configuration-and-local-verification"
    ],
    "independentReviewPerformed": false
  },
  "execution": {
    "engine": "pi-native",
    "externalAgentRunnersAllowed": false,
    "liveEnabled": false,
    "liveDispatcherImplemented": false,
    "maxModelCallsInFlight": 4,
    "reserveSlotsPerPair": 2,
    "maxPairsInFlight": 2,
    "recursiveShadows": false,
    "defaultProfile": "read-only-research",
    "sameModelFallbackAllowed": false
  },
  "shadowProtocol": {
    "start": "same-admission-batch",
    "initialContext": "fresh",
    "rawBriefShared": true,
    "producerTranscriptInitiallyShared": false,
    "producerArtifactGate": "shadow-preparation-required",
    "criticalFindings": "notify-immediately",
    "routineFindings": "checkpoint-batch",
    "publicSecondDeliverableRequired": false,
    "internalEvidenceRequired": true,
    "coauthoredPartsNeedFreshReview": true
  },
  "researchPolicy": {
    "searchCountIsCompletion": false,
    "fullTextForMaterialClaims": true,
    "sourceVersionRequired": true,
    "counterevidenceRequired": true,
    "budgetExhaustionMeans": "blocked",
    "missingMethodAction": "hypothesis-baseline-experiment",
    "noveltyClaimRequiresIndependentEvidence": true
  },
  "roles": [
    {
      "id": "D0",
      "slug": "coordinator",
      "title": "总协调",
      "responsibility": "任务契约、研究路线、依赖派工、预算与诚实交接",
      "main": "alpha-coordinator",
      "shadow": "alpha-coordinator-shadow",
      "skills": [
        "pi-alpha-core",
        "pi-alpha-evidence",
        "pi-alpha-experiment",
        "pi-alpha-planning"
